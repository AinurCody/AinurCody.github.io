---
import PostList from '../components/PostList.astro';
import StarChart from '../components/StarChart.astro';
import { SITE } from '../consts';
import Base from '../layouts/Base.astro';
import { getPosts } from '../lib/posts';

const posts = await getPosts();
const latest = posts.slice(0, 6);
---

<Base>
  <!-- 站名已经在页眉左上角，首页不再重复显示；这一行只留给读屏软件和搜索引擎。 -->
  <h1 class="visually-hidden">{SITE.title}</h1>
  <div class="home">
    <div class="sky">
      <StarChart posts={posts} />
    </div>
    <section class="latest" aria-label="最近的文章">
      {latest.length ? <PostList posts={latest} /> : <p class="empty">还没有文章。</p>}
      {
        posts.length > latest.length && (
          <p class="more">
            <a href="/posts/">全部 {posts.length} 篇文章</a>
          </p>
        )
      }
    </section>
  </div>
</Base>

<style>
  .home {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(15rem, 21rem);
    /* 左边是文章列表，右边是星图。 */
    grid-template-areas: 'latest sky';
    column-gap: 3rem;
    align-items: start;
    padding-top: 2.5rem;
  }

  .sky {
    grid-area: sky;
  }

  .latest {
    grid-area: latest;
  }

  .visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    margin: -1px;
    padding: 0;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
    border: 0;
  }

  .more {
    margin: 1rem 0 0;
    font-size: 0.9rem;
    color: var(--mut);
  }

  @media (max-width: 46rem) {
    .home {
      grid-template-columns: minmax(0, 1fr);
      grid-template-areas:
        'sky'
        'latest';
      padding-top: 1.5rem;
    }

    .sky {
      width: min(100%, 16rem);
      margin: 0 auto 1.75rem;
    }
  }
</style>
