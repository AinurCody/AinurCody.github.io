---
import { SITE } from '../consts';

const year = new Date().getFullYear();
---

<footer class="site-footer wrap">
  <span>© {year} {SITE.author}</span>
  <a href="/rss.xml">RSS</a>
</footer>

<style>
  .site-footer {
    display: flex;
    justify-content: space-between;
    margin-top: 4rem;
    margin-bottom: 2rem;
    padding-top: 1rem;
    border-top: 1px solid var(--line);
    font-size: 0.85rem;
    color: var(--mut);
  }
</style>
